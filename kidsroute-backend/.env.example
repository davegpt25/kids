DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kidsroute
DATABASE_USER=kidsroute
DATABASE_PASSWORD=kidsroute_dev

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

NODE_ENV=development

# 카카오 개발자 콘솔(developers.kakao.com)에서 발급
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback

# Google Cloud Console(console.cloud.google.com)에서 발급
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
